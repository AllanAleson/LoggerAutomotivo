    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.3.1",
    "@types/pg": "8.15.5",
    "supertest": "7.1.4",
    "@types/supertest": "6.0.3",
